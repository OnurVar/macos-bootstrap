{
  "name": "macos-bootstrap-app",
  "private": true,
  "type": "module",
  "description": "The terminal UI for macos-bootstrap. Picks steps and items, runs the step scripts, shows the log.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import tsx src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.6.0"
  }
}
